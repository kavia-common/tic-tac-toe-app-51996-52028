{
  "name": "tic-tac-toe-monolith",
  "private": true,
  "version": "1.0.0",
  "description": "Monolithic Tic Tac Toe app (React frontend + Node/Express backend)",
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "nodemon --watch backend --ext js,json --exec \"node backend/server.js\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "node backend/server.js",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:fix": "npm run lint:frontend:fix && npm run lint:backend:fix",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:frontend:fix": "npm --prefix frontend run lint:fix",
    "lint:backend": "npm --prefix backend run lint",
    "lint:backend:fix": "npm --prefix backend run lint:fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,css,html}\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "4.22.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.9",
    "prettier": "^3.7.4"
  }
}
